@Library('jShrLibs') _
pipeline {
    agent any

    parameters {
        string(name: 'IMAGE_TAG',     defaultValue: '', description: 'Docker image tag from upstream build')
        string(name: 'MANIFEST_REPO', defaultValue: '', description: 'Manifest repo URL')
        string(name: 'DOCKERHUB_NS',  defaultValue: '', description: 'Docker Hub namespace')
        string(name: 'SERVICE',       defaultValue: '', description: 'Service name')
        string(name: 'IMAGE',         defaultValue: '', description: 'Full image reference')
        string(name: 'MANIFEST_DIR',  defaultValue: '', description: 'Manifest folder path')
    }

    stages {
        stage('Update Manifest Repo') {
            steps {
                dir('manifests') {
                    gitClone("${params.MANIFEST_REPO}", "main", "git-creds")

                    sh """
                        sed -i "s#image: ${params.DOCKERHUB_NS}/${params.SERVICE}:.*#image: ${params.IMAGE}#g" ${params.MANIFEST_DIR}/${params.SERVICE}-deployment.yml
                    """

                    withCredentials([usernamePassword(
                        credentialsId: 'git-creds',
                        usernameVariable: 'GIT_USER',
                        passwordVariable: 'GIT_PASS'
                    )]) {
                        sh """
                            git config user.email "jenkins@ci.local"
                            git config user.name "jenkins-ci"
                            git add ${params.MANIFEST_DIR}/${params.SERVICE}-deployment.yml
                            git commit -m "Update ${params.SERVICE} image to ${params.IMAGE_TAG} (build ${env.BUILD_NUMBER})" || echo "No changes to commit"
                            git push https://${GIT_USER}:${GIT_PASS}@github.com/OzairKhan1/Kubernetes-ManifestFiles.git main
                        """
                    }
                }
            }
        }
    }

    post {
        success {
            mail to: 'ozairk050@gmail.com',
                 subject: "✅ Pipeline SUCCESS: ${env.JOB_NAME} #${env.BUILD_NUMBER}",
                 body: """Hello,
The Jenkins pipeline job '${env.JOB_NAME}' has succeeded.
Docker image updated to: ${params.IMAGE}
Build Number: ${env.BUILD_NUMBER}
Build URL: ${env.BUILD_URL}
Regards,
Jenkins
"""
        }
    }
}
